rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI and a firebase.json pointing at this file)

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own play-history subcollection.
    match /users/{userId}/history/{matchId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Basic shape validation on writes, so a compromised client can't
      // stuff arbitrary fields into a history document.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll(['mode', 'result', 'humanPlayer', 'playedAt'])
                    && request.resource.data.mode is string
                    && request.resource.data.result is string
                    && request.resource.data.humanPlayer is string;
    }

    // No other paths are readable/writable by clients by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
